---
import Layout from "../layouts/Layout.astro";
import fs from "fs";
import path from "path";

// Read the date from the public file
const dateFilePath = path.join(process.cwd(), "public", "last-reset-date.txt");
let daysSince = 0;

try {
  const dateString = fs.readFileSync(dateFilePath, "utf-8").trim();
  // Parse DD.MM.YYYY format
  const [day, month, year] = dateString.split(".").map(Number);
  const resetDate = new Date(year, month - 1, day);
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  resetDate.setHours(0, 0, 0, 0);
  daysSince = Math.floor(
    (today.getTime() - resetDate.getTime()) / (1000 * 60 * 60 * 24),
  );
} catch (e) {
  daysSince = 0;
}

const dayLabel = daysSince === 1 ? "DAY" : "DAYS";
---

<Layout title="FLI Web Team - Days Without Website Request">
  <main
    class="min-h-screen flex flex-col items-center justify-center py-12 scan-line"
  >
    <!-- Header -->
    <header class="w-3xl text-center mb-12 px-12 lg:px-20">
      <h1 class="text-3xl md:text-6xl font-bold mt-6 mb-4 glow-text">
        <span class="text-8xl md:text-9xl block mb-4">{daysSince}</span>
        {dayLabel} WITHOUT A NEW WEBSITE REQUEST FOR THE FLI WEB TEAM
      </h1>
    </header>

    <!-- Footer -->
    <footer class="mt-20 text-center text-gray-500 text-sm">
      <p>Counter resets when a new website request comes in.</p>
    </footer>
  </main>
</Layout>
